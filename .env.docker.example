# Docker Compose settings
COMPOSE_PROJECT_NAME=digital-innovation-lab
APP_PORT=3000
POSTGRES_DB=digital_innovation_lab
POSTGRES_USER=dil
POSTGRES_PASSWORD=__POSTGRES_PASSWORD__

# Application settings
SESSION_SECRET=__SESSION_SECRET__
SITE_URL=http://localhost:3000
VITE_SITE_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000
TRUST_PROXY=false
ENFORCE_HTTPS=false

# Optional email delivery
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=Digital Innovation Lab <no-reply@example.com>
ADMIN_NOTIFICATION_EMAIL=dil@aui.ma

# Optional Formspree contact-form integration (set before building)
VITE_FORMSPREE_ID=

# Backups
BACKUP_DIR=backups
BACKUP_RETENTION_DAYS=14
