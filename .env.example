# PostgreSQL and server-side authentication
VITE_SITE_URL=https://your-production-domain.com
SITE_URL=https://your-production-domain.com
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/digital_innovation_lab
DATABASE_SSL=false
SESSION_SECRET=replace-with-at-least-32-random-characters
UPLOAD_DIR=uploads
RESUME_DIR=private/resumes
ALLOWED_ORIGINS=http://localhost:8080
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user
SMTP_PASSWORD=your-smtp-password
EMAIL_FROM=Digital Innovation Lab <no-reply@example.com>
ADMIN_NOTIFICATION_EMAIL=dil@aui.ma
BACKUP_DIR=backups
BACKUP_RETENTION_DAYS=14
DATABASE_BACKUP_CONTAINER=dil-postgres
POSTGRES_DB=digital_innovation_lab
POSTGRES_USER=dil

# Formspree (contact form email notifications)
VITE_FORMSPREE_ID=your-formspree-form-id

# Express server (comma-separated allowed origins for CORS)
ALLOWED_ORIGINS=https://your-production-domain.com
TRUST_PROXY=true
ENFORCE_HTTPS=true
